@model MVCProject.Models.User

@{
    ViewData["Title"] = "Profile";
    @if (TempData["Error"] != null)
{
    <div class="alert alert-danger text-center">
        @TempData["Error"]
    </div>
}
}

<div class="container mt-5 d-flex justify-content-center">

    <div class="card shadow p-4" style="width: 400px;">

        <h3 class="text-center mb-4">User Profile</h3>

        <!-- Profile Image -->
        <div class="text-center mb-3">
            <img src="@Model.ImagePath" class="rounded-circle" style="width:120px;height:120px;object-fit:cover;"
                 alt="User Image" />
        </div>

        <!-- Username -->
        <div class="mb-2">
            <strong>Username:</strong>
            <p>@Model.Username</p>
        </div>

        <!-- Email -->
        <div class="mb-2">
            <strong>Email:</strong>
            <p>@Model.Email</p>
        </div>
         <!-- Mobile Number -->
        <div class="mb-2">
            <strong>Mobile Number:</strong>
            <p>@Model.Mobilenumber</p>
        </div>

        <!-- Password -->
        <div class="mb-2">
            <strong>Password:</strong>
            <p>********</p>
        </div>

        <!-- ✅ FORM + EDIT BUTTON SIDE BY SIDE -->
        <form asp-controller="Auth" asp-action="VerifyPasswordForEditProfile" method="post" class="d-flex gap-2">

            <input type="hidden" name="UserId" value="@Model.Id" />

            <input type="password" name="Password" class="form-control" placeholder="Enter password" required />

            <button type="submit" class="btn btn-primary">
                Edit Profile
            </button>

        </form>

        <!-- Logout -->
        <a asp-controller="Auth" asp-action="Logout" class="btn btn-danger w-100 mt-3">
            Logout
        </a>

    </div>
</div>