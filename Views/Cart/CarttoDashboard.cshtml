@{
    ViewData["Title"] = "Empty Cart";
}

<div style="min-height:100vh; display:flex; justify-content:center; align-items:center; background:#f5f6fa;">

    <div style="text-align:center; background:white; padding:50px; border-radius:15px; box-shadow:0 10px 30px rgba(0,0,0,0.1); width:400px;">

        <!-- ICON -->
        <div style="font-size:60px;">🛒</div>

        <!-- TITLE -->
        <h2 style="margin:15px 0; color:#333;">Your Cart is Empty</h2>

        <!-- SUB TEXT -->
        <p style="color:#777; margin-bottom:25px;">
            Looks like you haven't added anything to your cart yet.
        </p>

        <!-- BUTTON -->
        <a href="/Dashboard/Index"
           style="display:inline-block; padding:12px 25px; background:#28a745; color:white; text-decoration:none; border-radius:8px; font-weight:bold;">
            ⬅ Continue Shopping
        </a>

    </div>

</div>