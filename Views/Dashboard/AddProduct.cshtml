@model MVCProject.Dtos.ProductDto

<form asp-action="AddProduct"
      method="post"
      enctype="multipart/form-data"
      class="container mt-5"
      style="max-width: 400px;">

    <div class="card shadow p-4">

        <h3 class="text-center mb-4">Add Product</h3>

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" placeholder="Enter Product Name" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <input asp-for="Description" class="form-control" placeholder="Enter Product Description" />
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Price" class="form-label"></label>
            <input asp-for="Price" type="number" step="0.01" class="form-control" placeholder="Enter Product Price" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>

        <!-- ✅ ONLY ADDED PART -->
        <div class="mb-3">
            <label class="form-label">Product Image</label>
            <input type="file" name="ImageFile" class="form-control" />
        </div>

        <div class="d-grid">
            <button type="submit" class="btn btn-success">Submit</button>
        </div>

    </div>
</form>